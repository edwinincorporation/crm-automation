PORT=3000
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-now
COOKIE_SECURE=1            # set 1 when served over https

# Zoho CRM (India DC). Create a Self Client at api-console.zoho.in with scopes:
# ZohoCRM.modules.ALL,ZohoCRM.settings.ALL,ZohoCRM.users.READ,ZohoCRM.notes.ALL
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_URL=https://www.zohoapis.in

# Email + letters (SMTP)
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=1
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
LETTER_HEADER=Edwin Incorporation

# WhatsApp (Interakt)
INTERAKT_API_KEY=

# Email Analysis auto-feed (header x-ingest-key)
INGEST_KEY=

# Safety: DRY_RUN=1 records sends but does not actually send. DEMO=1 uses sample data, no Zoho calls.
DRY_RUN=1
